# Variáveis de ambiente do site L2 Versus.
#
# Copie para `.env.local` (que é gitignored) para rodar localmente, e
# cadastre as mesmas chaves no painel do Coolify para o deploy.
# NUNCA versione o arquivo preenchido — este exemplo existe justamente para
# que o arquivo com valores reais nunca precise entrar no repositório.

# --- Banco da rev (MariaDB do servidor de jogo) -----------------------------
# No Coolify, DB_HOST não pode ser 127.0.0.1: aponte para o host/container que
# realmente alcança o MariaDB (nome do serviço na rede do Docker, IP interno
# da VPS, ou túnel). 127.0.0.1 dentro do container é o PRÓPRIO container.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=l2jversush5

# --- Sessão -----------------------------------------------------------------
# OBRIGATÓRIA em produção: sem ela o boot falha de propósito (lib/session.ts).
# Gere uma string longa e aleatória, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Público (vai para o bundle do browser — nada de segredo aqui) ----------
# URL canônica do site; usada para montar o link de indicação.
NEXT_PUBLIC_SITE_URL=https://l2versus.com
# Nome da moeda exibido no painel do jogador.
NEXT_PUBLIC_COIN_NAME=VSCOIN
